# Supabase Configuration
# Znajdź te wartości w: Supabase Dashboard → Settings → API

# URL projektu Supabase (np. https://xxxxx.supabase.co)
SUPABASE_URL=https://wcibdbsemxphokxftlgt.supabase.co

# Anon/Public Key - długi token JWT zaczynający się od eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Znajdziesz go w sekcji "Project API keys" → "anon" "public"
SUPABASE_ANON_KEY=your-anon-key-here

# Service Role Key - wrażliwy klucz do operacji administracyjnych
# Znajdziesz go w sekcji "Project API keys" → "service_role" "secret"
# UWAGA: Nie udostępniaj tego klucza publicznie!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Port serwera
PORT=3000
